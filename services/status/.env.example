# RENAME to .env.example (my write to that name was blocked by a permission rule). Copy to .env (gitignored) for local
# runs; on Coolify set the same names as runtime env vars. Never commit real values.
PORT=3000

# Discord: the "mrh.lol status" bot. Needs the GUILD_PRESENCES and GUILD_MEMBERS privileged intents (Developer Portal, Bot tab).
# Leave DISCORD_TOKEN empty and the service still runs with Roblox + Steam only.
DISCORD_TOKEN=
# Empty = the bot's only guild.
DISCORD_GUILD_ID=
# Comma-separated Discord usernames (not display names) to watch; both must be members of that server.
DISCORD_WATCH=makogai,mrharold01

# Roblox presence (public API, polled server-side). The user id is already public in the site config.
STATUS_ROBLOX_USER_ID=1113999731

# Steam, public profiles (no API key). IDs, never persona names: the relay does not emit them.
STATUS_STEAM_MAIN=76561198259591769
STATUS_STEAM_CS=76561198127541580

# Privacy allowlist (1/true = emit, anything else = drop). Spotify is OFF unless you opt in.
STATUS_SHOW_DISCORD=1
STATUS_SHOW_ACTIVITY=1
STATUS_SHOW_CUSTOM=1
STATUS_SHOW_SPOTIFY=0
STATUS_SHOW_ROBLOX_GAME=1
STATUS_SHOW_STEAM=1

# Extra allowed CORS origins (comma-separated). https://mrh.lol and http://localhost:* are always allowed.
STATUS_CORS_ORIGINS=
